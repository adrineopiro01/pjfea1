# Copy to .env.local for `vercel dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "service_role" secret key. Server-only: never put it in index.html or script.js.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Flutterwave dashboard → Settings → API keys (use the TEST secret key until you go live)
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
# Any long random string; paste the same value in Flutterwave → Settings → Webhooks → Secret hash
FLW_SECRET_HASH=change-me-to-a-long-random-string

# Optional: where donors return after paying (defaults to the domain the request came in on)
SITE_URL=https://pjfea.org
